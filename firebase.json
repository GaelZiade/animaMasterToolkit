{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "anima-master-toolkit-fork",
          "appId": "1:468315049178:android:7982f2559df54963ac69e3",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "anima-master-toolkit-fork",
          "configurations": {
            "android": "1:468315049178:android:7982f2559df54963ac69e3",
            "web": "1:468315049178:web:2d60cde5d9a5c280ac69e3",
            "windows": "1:468315049178:web:da42338a64580a79ac69e3"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
